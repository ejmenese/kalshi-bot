import os, time, requests
from datetime import datetime

# --- CONFIG 5% AGRESIVO ---
RISK_PER_TRADE = 0.05
MIN_LIQUIDITY = 1000 # Filtro anti "No liquidity" como tu trade de Sureshkumar
BUDGET_SPLIT = {"momentum": 0.4, "contrarian": 0.3, "data": 0.3} # 40% / 30% / 30%

KALSHI_EMAIL = os.getenv("KALSHI_EMAIL")
KALSHI_PASSWORD = os.getenv("KALSHI_PASSWORD")
API = "https://api.elections.kalshi.com/trade-api/v2"

def login():
    r = requests.post(f"{API}/login", json={"email": KALSHI_EMAIL, "password": KALSHI_PASSWORD})
    r.raise_for_status()
    return r.json()["token"]

# --- ESTRATEGIA 1: MOMENTUM (sigue al dinero) ---
def estrategia_momentum(market):
    # Si el precio subió 10c en la última hora y el volumen está explotando, súbete
    change_1h = market.get("price_change_1h", 0)
    volume_spike = market["volume"] > market.get("avg_volume", 0) * 2
    if change_1h >= 10 and volume_spike and market["yes_bid"] < 75:
        return {"side": "yes", "reason": f"Momentum +{change_1h}c con volumen x2"}
    return None

# --- ESTRATEGIA 2: CONTRARIAN (compra pánico) ---
def estrategia_contrarian(market):
    # Si el precio cayó de golpe a menos de 30c pero el mercado sigue abierto, compra barato
    if market["yes_bid"] <= 30 and market["volume"] >= MIN_LIQUIDITY:
        # Busca que haya caído >20c en poco tiempo = sobreventa
        if market.get("price_change_1h", 0) <= -20:
            return {"side": "yes", "reason": f"Contrarian caída -20c a {market['yes_bid']}c"}
    return None

# --- ESTRATEGIA 3: DATA (solo para tenis como tu apuesta) ---
def estrategia_data(market):
    # Solo aplica si es tenis
    if "tennis" not in market["ticker"].lower():
        return None
    # Aquí conectas datos reales. Ejemplo simple:
    # Si el favorito del mercado (yes >60) pero su rival viene de perder 3 seguidos, confirma
    # Para la versión pro, aquí se conecta a API de ATP rankings
    if market["yes_bid"] >= 60 and market["yes_bid"] <= 75:
        return {"side": "yes", "reason": f"Data - Favorito sólido {market['yes_bid']}c en rango óptimo"}
    return None

def ejecutar():
    token = login()
    headers = {"Authorization": f"Bearer {token}"}
    print(f"[{datetime.now()}] BOT 3X INICIADO - 5% agresivo")

    while True:
        try:
            # 1. Balance
            bal = requests.get(f"{API}/portfolio/balance", headers=headers).json()
            cash = bal["cash"] / 100
            base_bet = cash * RISK_PER_TRADE
            print(f"Cash: ${cash:.2f} | Apuesta base 5%: ${base_bet:.2f}")

            # 2. Mercados
            markets = requests.get(f"{API}/markets?status=open&limit=100", headers=headers).json()["markets"]

            for m in markets:
                if m["volume"] < MIN_LIQUIDITY: continue

                # Prueba las 3 estrategias
                for nombre, func in [("momentum", estrategia_momentum), ("contrarian", estrategia_contrarian), ("data", estrategia_data)]:
                    señal = func(m)
                    if señal:
                        monto = base_bet * BUDGET_SPLIT[nombre]
                        print(f"[{nombre.upper()}] {m['ticker']} -> {señal['reason']} | Monto: ${monto:.2f}")

                        # ORDEN REAL - Descomenta cuando estés listo
                        # order = {
                        # "ticker": m["ticker"],
                        # "side": señal["side"],
                        # "type": "limit",
                        # "count": int((monto*100) / m["yes_ask"]),
                        # "yes_price": m["yes_ask"]
                        # }
                        # requests.post(f"{API}/portfolio/orders", headers=headers, json=order)

            # 3. Gestión de posiciones abiertas (tu posición de 93.6 Yes)
            posiciones = requests.get(f"{API}/portfolio/positions", headers=headers).json()
            for pos in posiciones.get("positions", []):
                # Take profit automático a 88c
                if pos["market_price"] >= 88:
                    print(f"TAKE PROFIT: Vendiendo {pos['ticker']} a {pos['market_price']}c")
                    # requests.post(... sell...)
                # Stop loss a 35c
                if pos["market_price"] <= 35:
                    print(f"STOP LOSS: Vendiendo {pos['ticker']} a {pos['market_price']}c")

        except Exception as e:
            print(f"Error {e}, re-login en 60s")
            try: token = login(); headers = {"Authorization": f"Bearer {token}"}
            except: pass

        time.sleep(60)

if __name__ == "__main__":
    ejecutar()
