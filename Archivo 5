import os, time, requests
from datetime import datetime
from atp_data import evaluar_apuesta_data

RISK_PER_TRADE = 0.05
MIN_LIQUIDITY = 1000
BUDGET_SPLIT = {"momentum": 0.4, "contrarian": 0.3, "data": 0.3}
API = "https://api.elections.kalshi.com/trade-api/v2"

KALSHI_EMAIL = os.getenv("KALSHI_EMAIL")
KALSHI_PASSWORD = os.getenv("KALSHI_PASSWORD")

def login():
    r = requests.post(f"{API}/login", json={"email": KALSHI_EMAIL, "password": KALSHI_PASSWORD})
    r.raise_for_status()
    return r.json()["token"]

def estrategia_momentum(m):
    if m.get("price_change_1h",0) >= 10 and m["volume"] > 1000 and m["yes_bid"] < 75:
        return {"side":"yes","reason":f"Momentum +{m.get('price_change_1h')}c"}
    return None

def estrategia_contrarian(m):
    if m["yes_bid"] <= 30 and m.get("price_change_1h",0) <= -20:
        return {"side":"yes","reason":f"Contrarian caída a {m['yes_bid']}c"}
    return None

def estrategia_data(m):
    ok, reason = evaluar_apuesta_data(m["ticker"], m["yes_bid"])
    if ok: return {"side":"yes","reason":reason}
    return None

def ejecutar():
    token = login()
    headers = {"Authorization": f"Bearer {token}"}
    print(f"[{datetime.now()}] BOT 3X AGRESIVO 5% ONLINE")
    while True:
        try:
            bal = requests.get(f"{API}/portfolio/balance", headers=headers).json()
            cash = bal["cash"]/100
            base_bet = cash * RISK_PER_TRADE

            markets = requests.get(f"{API}/markets?status=open&limit=100", headers=headers).json()["markets"]
            for m in markets:
                if m["volume"] < MIN_LIQUIDITY: continue
                for nombre, func in [("momentum",estrategia_momentum),("contrarian",estrategia_contrarian),("data",estrategia_data)]:
                    señal = func(m)
                    if señal:
                        monto = base_bet * BUDGET_SPLIT[nombre]
                        print(f"[{nombre}] {m['ticker']} {señal['reason']} Monto ${monto:.2f}")
                        # DESCOMENTA PARA OPERAR REAL:
                        # requests.post(f"{API}/portfolio/orders", headers=headers, json={"ticker":m["ticker"],"side":"yes","type":"limit","count":int((monto*100)/m["yes_ask"]),"yes_price":m["yes_ask"]})

            time.sleep(60)
        except Exception as e:
            print(f"Error {e}"); time.sleep(60)
            try: token = login(); headers = {"Authorization": f"Bearer {token}"}
            except: pass

if __name__ == "__main__":
    ejecutar()
